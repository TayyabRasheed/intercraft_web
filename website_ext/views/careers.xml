<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="career" model="website.page">
        <field name="name">Career</field>
        <field name="type">qweb</field>
        <field name="url">/career</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.career</field>
        <field name="arch" type="xml">
            <t name="Career" t-name="website_ext.career">
                <t t-call="website.layout">
                    <t t-set="head">
                        <link rel="stylesheet" type="text/css" href="/website_ext/static/src/css/people_culture.css"/>
                        <link rel="stylesheet" type="text/css"
                              href="/website_ext/static/src/css/people_culture_animation.css"/>
                        <link rel="stylesheet" type="text/css" href="/website_ext/static/src/css/careers.css"/>
                        <script src="/website_ext/static/src/js/animation.js"></script>
                    </t>
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <section class="service-hero career-hero"
                             style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/website_ext/static/src/images/career/career-bg.jpg') center/cover; height: 503px;">
                        <div class="container">
                            <div class="hero-content text-center">
                                <h1 class="hero-heading-career">Build the Future With Us</h1>
                                <p class="hero-subtitle" style="color: white; font-size: 1.2rem; margin-bottom: 30px">
                                    Join a team of innovators, creators, and problem-solvers shaping what's next.
                                </p>
                                <a href="#jobs-section" class="service-cta-btn">Explore Jobs</a>
                            </div>
                        </div>
                    </section>

                    <section class="who-we-are" style="padding: 80px 0; background: #f8f9fa">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-10 text-center">
                                    <p style="font-size: 26px;line-height: 1.5;color: #303030;font-weight: 500;margin: 0;">
                                        We're a global software company fueled by innovation, collaboration, and real
                                        impact.
                                        Join a diverse, data-driven team that values ownership, curiosity, and
                                        continuous
                                        learning.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section style="padding: 80px 0; background: #f8f9fa" id="jobs-section">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 style="font-size: 32px; font-weight: 700; color: #303030; margin-bottom: 30px;">
                                    Open Positions
                                </h2>
                                <div class="row justify-content-center">
                                    <div class="col-lg-8">
                                        <p style="font-size: 16px; font-weight: 500; line-height: 1.5; color: #4C4C4C">
                                            At Intercraft, we’ve grown into structured teams while keeping our
                                            collaborative
                                            spirit strong.
                                            We work together with respect, trust, and a shared purpose.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="row justify-content-center">
                                <div class="container">
                                    <div class="row justify-content-center" id="jobs-container">
                                        <t t-if="job_departments">
                                            <t t-foreach="job_departments" t-as="job">
                                                <div class="col-lg-3 col-md-6 col-sm-12 mb-4 d-flex align-items-stretch">
                                                    <div class="job-card w-100">
                                                        <t t-if="job['image']">
                                                            <img t-att-src="'data:image/png;base64,' + job['image'].decode('utf-8')"
                                                                 class="card-img-top" t-att-alt="job['name']"/>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                                 style="height: 240px;">
                                                                <i class="fa fa-building fa-3x text-muted"></i>
                                                            </div>
                                                        </t>
                                                        <div class="card-body">
                                                            <h5 class="card-title" t-esc="job['name']"></h5>
                                                            <a t-att-href="job['url']" class="contact-btn">View
                                                                Details
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="col-12 text-center">
                                                <h4 class="text-muted">We're not hiring currently, but we'd love to hear
                                                    from you later!
                                                </h4>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!--                    animation section animation>-->
                    <section class="people-culture-section">
                        <div class="container">
                            <div class="culture-header">
                                <h2>People and Culture We Offer</h2>
                                <p>We're not just a company; we're a community of passionate and curious builders driven
                                    to reimagine what's possible.
                                </p>
                            </div>
                        </div>

                        <div class="animation-stage">
                            <div class="svg-container">
                                <svg viewBox="0 0 1440 500" preserveAspectRatio="none"
                                     xmlns="http://www.w3.org/2000/svg" class="w-100 h-100">
                                    <path class="culture-wave line-1"
                                          d="M-50,220 C100,-50 250,150 450,400 C650,650 850,50 1150,50 C1300,50 1400,80 1500,100"
                                          fill="none" stroke="#E85C0D" stroke-width="2.5" stroke-linecap="round"/>
                                    <path class="culture-wave line-2"
                                          d="M-50,250 C100,220 250,580 600,480 C800,420 950,250 1050,300 C1150,400 1300,700 1500,900"
                                          fill="none" stroke="rgba(232,92,13,0.3)" stroke-width="2"
                                          stroke-linecap="round"/>
                                </svg>
                            </div>


                            <div class="slider-container">
                                <div class="slider-track" id="sliderTrack">
                                    <t t-foreach="culture_images" t-as="img_rec">
                                        <div t-attf-class="slide-item #{img_rec.orientation}">
                                            <div class="img-card">
                                                <img t-attf-src="/web/image/website.event.image/#{img_rec.id}/image/1024x1024"
                                                     t-att-alt="img_rec.name"
                                                     loading="lazy"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="careers-benefits-section">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6 benefits-content">
                                    <h2 class="benefits-title">The Benefits Working at The Intercraft</h2>
                                    <p class="benefits-intro">We recognize that compensation and benefits play a major
                                        part in making sure that you feel you can focus on your work.
                                    </p>
                                    <p class="benefits-intro">We offer generous packages to make sure you feel respected
                                        and appreciated as an employee.
                                    </p>
                                </div>
                                <div class="col-lg-6">
                                    <ul class="benefits-list">
                                        <li class="benefit-item">
                                            <span class="benefit-icon">
                                                <i class="fa fa-users" aria-hidden="true"></i>
                                            </span>
                                            <div class="benefit-text">
                                                <h3 class="benefit-title">Lively Working Environment</h3>
                                                <p class="benefit-desc">Work where energy, creativity, and collaboration
                                                    thrive.
                                                </p>
                                            </div>
                                        </li>
                                        <li class="benefit-item">
                                            <span class="benefit-icon">
                                                <i class="fa fa-star" aria-hidden="true"></i>
                                            </span>
                                            <div class="benefit-text">
                                                <h3 class="benefit-title">Performance Bonus</h3>
                                                <p class="benefit-desc">Your hard work pays off—literally.</p>
                                            </div>
                                        </li>
                                        <li class="benefit-item">
                                            <span class="benefit-icon">
                                                <i class="fa fa-heart" aria-hidden="true"></i>
                                            </span>
                                            <div class="benefit-text">
                                                <h3 class="benefit-title">Health Insurance</h3>
                                                <p class="benefit-desc">Comprehensive coverage for your peace of mind.
                                                </p>
                                            </div>
                                        </li>
                                        <li class="benefit-item">
                                            <span class="benefit-icon">
                                                <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                                            </span>
                                            <div class="benefit-text">
                                                <h3 class="benefit-title">Continuous Learning</h3>
                                                <p class="benefit-desc">Grow your skills with endless learning
                                                    opportunities.
                                                </p>
                                            </div>
                                        </li>
                                        <li class="benefit-item">
                                            <span class="benefit-icon">
                                                <i class="fa fa-child" aria-hidden="true"></i>
                                            </span>
                                            <div class="benefit-text">
                                                <h3 class="benefit-title">Parental Leave</h3>
                                                <p class="benefit-desc">Support that puts your family first.</p>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="innovate innovate-career">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Let’s Get be Part of Our Team</h2>
                                <p class="innovate-subtitle">
                                    Let’s collaborate to turn your ideas into impactful digital solutions.
                                </p>

                                <a href="/career" class="ic-btn-build-solid mb-2"
                                   style=" position: relative; z-index: 2;">See Open Positions
                                </a>
                            </div>
                        </div>
                    </section>

                </t>
            </t>
        </field>
    </record>
    <record id="menu_career" model="website.menu">
        <field name="name">career</field>
        <field name="url">/career</field>
        <field name="page_id" ref="website_ext.career"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>