<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="our_work" model="website.page">
        <field name="name">Our Work</field>
        <field name="type">qweb</field>
        <field name="url">/our-work</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.our_work</field>
        <field name="arch" type="xml">
            <t name="Our Work" t-name="website_ext.our_work">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure ic_work_page">

                        <section class="ic-hero-section">
                            <div class="container text-center">
                                <h1 class="ic-hero-title">Real Results Through Strategic Innovation</h1>
                                <p class="ic-hero-subtitle mx-auto">
                                    At InterCraft, our work reflects real impact — from system modernization to
                                    AI-driven solutions that accelerate growth and streamline operations.
                                </p>
                                <div class="row g-4 justify-content-center ic-hero-gallery">
                                    <div class="col-md-4">
                                        <div class="ic-hero-img-wrapper">
                                            <img src="/website_ext/static/src/images/our-work/img1.png"
                                                 class="ic-hero-img"/>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="ic-hero-img-wrapper">
                                            <img src="/website_ext/static/src/images/our-work/img2.png"
                                                 class="ic-hero-img"/>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="ic-hero-img-wrapper">
                                            <img src="/website_ext/static/src/images/our-work/img3.png"
                                                 class="ic-hero-img"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="ic-build-section">
                            <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                            <div class="container">
                                <div class="text-center mb-5">
                                    <span class="ic-section-label">Our Work</span>
                                    <h2 class="ic-section-main-title">What We Build</h2>
                                </div>
                                <div class="row g-4">
                                    <div class="col-lg-5 col-md-6">
                                        <div class="ic-build-card">
                                            <div class="ic-build-icon-box">
                                                <i class="fa fa-magic"></i>
                                            </div>
                                            <h4 class="ic-build-card-title">AI Portals &amp; Intelligent Systems</h4>
                                            <p class="ic-build-card-text">Harness the power of artificial intelligence
                                                to transform your business operations. We create intelligent systems
                                                that learn and adapt.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-7 col-md-6">
                                        <div class="ic-build-card">
                                            <div class="ic-build-icon-box">
                                                <i class="fa fa-bullseye"></i>
                                            </div>
                                            <h4 class="ic-build-card-title">Project Management &amp; Delivery</h4>
                                            <p class="ic-build-card-text">Navigate complex projects with confidence. Our
                                                agile approach ensures timely delivery, transparent communication, and
                                                seamless execution from concept to launch.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-7 col-md-6">
                                        <div class="ic-build-card">
                                            <div class="ic-build-icon-box">
                                                <i class="fa fa-globe"></i>
                                            </div>
                                            <h4 class="ic-build-card-title">Web Development</h4>
                                            <p class="ic-build-card-text">Build robust, scalable web applications with
                                                modern technologies. We deliver high-performance solutions tailored to
                                                your business needs.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-5 col-md-6">
                                        <div class="ic-build-card">
                                            <div class="ic-build-icon-box">
                                                <i class="fa fa-paint-brush"></i>
                                            </div>
                                            <h4 class="ic-build-card-title">UI/UX Design</h4>
                                            <p class="ic-build-card-text">Craft beautiful, intuitive interfaces that
                                                users love. Our design process combines research and modern aesthetics.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="ic-projects-section">
                            <div class="container">
                                <h2 class="ic-section-main-title text-center mb-5">Our Recent Projects</h2>
                                <t t-set="projects"
                                   t-value="request.env['website.project'].sudo().search([('active', '=', True)], order='sequence, id')"/>
                                <t t-set="num_projects" t-value="len(projects)"/>
                                <t t-set="double_count" t-value="num_projects * 2"/>
                                <div class="ic-projects-viewport" t-if="projects">
                                    <div class="ic-projects-row ic-projects-track" t-att-data-count="num_projects"
                                         t-attf-style="width: {{ double_count * 100 / 3 }}%; --ic-track-width-mobile: {{ double_count * 100 }}%;">
                                        <t t-foreach="projects" t-as="project">
                                            <div class="ic-project-col ic-project-col-idx"
                                                 t-att-data-index="project_index - 1"
                                                 t-attf-style="flex: 0 0 {{ 100.0 / double_count }}%; max-width: {{ 100.0 / double_count }}%;">
                                                <div class="ic-project-card">
                                                    <div class="ic-project-card-header">
                                                        <t t-if="project.badge">
                                                            <span t-attf-class="ic-project-badge badge-#{project.badge_style or 'website'}">
                                                                <t t-esc="project.badge"/>
                                                            </span>
                                                        </t>
                                                        <t t-if="project.logo">
                                                            <img t-att-src="'/web/image/website.project/%s/logo' % project.id"
                                                                 class="ic-project-logo" alt=""/>
                                                        </t>
                                                    </div>
                                                    <div class="ic-project-img-container">
                                                        <t t-if="project.image">
                                                            <img t-att-src="'/web/image/website.project/%s/image' % project.id"
                                                                 class="ic-project-img" alt=""/>
                                                        </t>
                                                        <t t-else="">
                                                            <img src="/web/image/website.s_picture_default_image"
                                                                 class="ic-project-img" alt=""/>
                                                        </t>
                                                    </div>
                                                    <div class="ic-project-content">
                                                        <h4 class="ic-project-title">
                                                            <t t-esc="project.title or project.name"/>
                                                        </h4>
                                                        <div class="ic-project-tags" t-if="project.tag_ids">
                                                            <t t-foreach="project.tag_ids" t-as="tag">
                                                                <span>
                                                                    <t t-esc="tag.name"/>
                                                                </span>
                                                            </t>
                                                        </div>
                                                        <p class="ic-project-desc" t-if="project.description">
                                                            <t t-esc="project.description"/>
                                                        </p>
                                                        <a t-att-href="project.url or '#'" class="ic-project-link">Learn
                                                            More
                                                            <i class="fa fa-arrow-right ms-1"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                        <t t-foreach="projects" t-as="project">
                                            <div class="ic-project-col ic-project-col-idx"
                                                 t-att-data-index="project_index - 1 + num_projects"
                                                 t-attf-style="flex: 0 0 {{ 100.0 / double_count }}%; max-width: {{ 100.0 / double_count }}%;">
                                                <div class="ic-project-card">
                                                    <div class="ic-project-card-header">
                                                        <t t-if="project.badge">
                                                            <span t-attf-class="ic-project-badge badge-#{project.badge_style or 'website'}">
                                                                <t t-esc="project.badge"/>
                                                            </span>
                                                        </t>
                                                        <t t-if="project.logo">
                                                            <img t-att-src="'/web/image/website.project/%s/logo' % project.id"
                                                                 class="ic-project-logo" alt=""/>
                                                        </t>
                                                    </div>
                                                    <div class="ic-project-img-container">
                                                        <t t-if="project.image">
                                                            <img t-att-src="'/web/image/website.project/%s/image' % project.id"
                                                                 class="ic-project-img" alt=""/>
                                                        </t>
                                                        <t t-else="">
                                                            <img src="/web/image/website.s_picture_default_image"
                                                                 class="ic-project-img" alt=""/>
                                                        </t>
                                                    </div>
                                                    <div class="ic-project-content">
                                                        <h4 class="ic-project-title">
                                                            <t t-esc="project.title or project.name"/>
                                                        </h4>
                                                        <div class="ic-project-tags" t-if="project.tag_ids">
                                                            <t t-foreach="project.tag_ids" t-as="tag">
                                                                <span>
                                                                    <t t-esc="tag.name"/>
                                                                </span>
                                                            </t>
                                                        </div>
                                                        <p class="ic-project-desc" t-if="project.description">
                                                            <t t-esc="project.description"/>
                                                        </p>
                                                        <a t-att-href="project.url or '#'" class="ic-project-link">Learn
                                                            More
                                                            <i class="fa fa-arrow-right ms-1"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="ic-projects-dots text-center mt-5" aria-hidden="true" t-if="projects">
                                    <span class="ic-dot" data-index="0" role="button" tabindex="0"
                                          aria-label="Project 1"></span>
                                    <span class="ic-dot" data-index="1" role="button" tabindex="0"
                                          aria-label="Project 2"></span>
                                    <span class="ic-dot" data-index="2" role="button" tabindex="0"
                                          aria-label="Project 3"></span>
                                </div>
                            </div>
                        </section>

                        <section class="ic-final-wrap-section">
                            <div class="container">
                                <div class="ic-cta-banner-wrapper">
                                    <div class="row align-items-center">
                                        <div class="col-lg-8">
                                            <h2 class="ic-cta-title">Build faster solutions with our AI technology</h2>
                                            <p class="ic-cta-text">Each project we undertake is designed for measurable
                                                outcomes, performance, efficiency, and future readiness.
                                            </p>
                                        </div>
                                        <div class="col-lg-4 text-lg-end text-center mt-4 mt-lg-0">
                                            <a href="/ai-expert" class="ic-btn-main-orange">See Our AI Services</a>
                                        </div>
                                    </div>
                                </div>

                                <div class="ic-testimonial-head ">
                                    <span class="ic-section-label">What Our Clients Say</span>
                                    <h2 class="ic-section-main-title">Real Results. Real Feedback.</h2>
                                </div>

                                <t t-set="testimonials"
                                   t-value="request.env['website.testimonial'].sudo().search([('active', '=', True)], order='sequence, id')"/>
                                <div class="ic-testimonial-slider mt-5" t-if="testimonials">
                                    <div class="d-none ic-testimonial-data" id="ic-testimonial-data">
                                        <t t-foreach="testimonials" t-as="t">
                                            <div class="ic-testimonial-item">
                                                <span class="data-title">
                                                    <t t-esc="t.title"/>
                                                </span>
                                                <span class="data-quote">
                                                    <t t-esc="t.quote"/>
                                                </span>
                                                <span class="data-author">
                                                    <t t-esc="t.author_name"/>
                                                </span>
                                                <span class="data-role">
                                                    <t t-esc="t.author_role or ''"/>
                                                </span>
                                                <span class="data-company">
                                                    <t t-esc="t.company_name or ''"/>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="row g-4 align-items-center justify-content-center">
                                        <div class="col-md-3 d-none d-lg-block">
                                            <div class="ic-testimonial-card faded ic-testi-slot-left">
                                                <h5 class="ic-testi-title ic-testi-slot-title"></h5>
                                                <p class="small ic-testi-slot-quote"></p>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 col-md-10">
                                            <div class="ic-testimonial-card active ic-testi-slot-center">
                                                <h4 class="ic-testi-title ic-testi-slot-title"></h4>
                                                <p class="ic-testi-text ic-testi-slot-quote"></p>
                                                <div class="ic-testi-footer">
                                                    <strong class="ic-testi-slot-author"></strong>
                                                    <span class="ic-testi-slot-company"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 d-none d-lg-block">
                                            <div class="ic-testimonial-card faded ic-testi-slot-right">
                                                <h5 class="ic-testi-title ic-testi-slot-title"></h5>
                                                <p class="small ic-testi-slot-quote"></p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="ic-testimonial-bars text-center mt-5" aria-hidden="true">
                                        <span class="ic-testi-bar"></span>
                                        <span class="ic-testi-bar"></span>
                                        <span class="ic-testi-bar"></span>
                                    </div>
                                </div>
                                <section class="innovate">
                                    <div class="container text-center">
                                        <div class="innovate-content">
                                            <h2 class="innovate-title">Let's Build Something Smart</h2>
                                            <p class="innovate-subtitle">
                                                Have an idea or need help upgrading your digital product? Let's talk and
                                                turn your vision into reality.
                                            </p>
                                            <a href="/contact-us" class="ic-btn-build-outline mb-2" style=" position: relative; z-index: 2;">
                                                <i class="fa fa-comments-o " aria-hidden="true"/>
                                                Let's Talk
                                            </a>
                                            <a href="/contact-us" class="ic-btn-build-solid mb-2" style=" position: relative; z-index: 2;">Book a Free Consultation
                                            </a>
                                        </div>
                                    </div>
                                </section>

                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>