<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_image_tree" model="ir.ui.view">
        <field name="name">website.event.image.tree</field>
        <field name="model">website.event.image</field>
        <field name="arch" type="xml">
            <tree string="Event Images">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="orientation"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_event_image_form" model="ir.ui.view">
        <field name="name">website.event.image.form</field>
        <field name="model">website.event.image</field>
        <field name="arch" type="xml">
            <form string="Event Image">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_active"/>
                        <field name="orientation" readonly="0"/>
                    </group>
                    <group>
                        <field name="image" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_image" model="ir.actions.act_window">
        <field name="name">Event Images</field>
        <field name="res_model">website.event.image</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_event_image" 
              name="Event Images" 
              parent="team_member_root_menu" 
              action="action_event_image" 
              sequence="20"/>
</odoo>