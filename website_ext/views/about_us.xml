<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aboutus" model="website.page">
        <field name="name">About Us</field>
        <field name="type">qweb</field>
        <field name="url">/aboutus</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.aboutus</field>
        <field name="arch" type="xml">
            <t name="About Us Page" t-name="website_ext.aboutus">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <section class="service-hero">
                        <div class="service-hero-bg "

                             style="background: url('/website_ext/static/src/images/about-us/about-us-bg.jpg') center / cover;"></div>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">Transforming Ideas Into Human Centered Designs
                                        </h1>
                                        <p class="service-hero-subtitle">At InterCraft, we fuse innovation, expertise,
                                            and technology to
                                            build scalable solutions that empower businesses, streamline systems, and
                                            drive digital growth
                                            across industries.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Who We Are Section -->
                    <section class="who-we-are">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="section-label">Who We Are</div>
                                    <h2 class="section-title">
                                        Empowering Digital Growth Since 2016
                                    </h2>
                                    <p class="section-description">
                                        We are a forward-thinking software company delivering web-based
                                        solutions that simplify processes and enhance productivity.
                                        Specializing in Artificial Intelligence, LMS, Odoo, Moodle, and mobile apps, we use
                                        open-source technologies to build smart, scalable systems. Our
                                        focus: simple, innovative, and unified digital experiences.
                                    </p>
                                    <a href="/aboutus" class="learn-more-btn">Learn More</a>
                                </div>
                                <div class="col-lg-6">
                                    <div class="ai-image-container">
                                        <img
                                                src="/website_ext/static/src/images/who-we-are-section/ai.png"
                                                alt="AI Technology"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Partners Section with Automatic Carousel -->
                    <section class="partners">
                        <div class="container text-center">
                            <h3 class="partners-title">
                                We partner with forward-thinking businesses to boost efficiency and<br/>drive
                                digital transformation
                            </h3>
                            <div
                                    id="partnersCarousel"
                                    class="carousel slide"
                                    data-bs-ride="carousel"
                                    data-bs-interval="3000"
                            >
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="partners-logos">
                                            <div class="row">
                                                <div class="col-md-3 col-sm-6 col-6">
                                                    <div class="partner-logo-container">
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/logo1.png"
                                                                alt="Partner 1"
                                                                class="img-fluid partner-logo-default"
                                                        />
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/coloured-logo/logo-1.png"
                                                                alt="Partner 1"
                                                                class="img-fluid partner-logo-colored"
                                                        />
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-6">
                                                    <div class="partner-logo-container">
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/logo2.png"
                                                                alt="Partner 2"
                                                                class="img-fluid partner-logo-default"
                                                        />
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/coloured-logo/logo-2.png"
                                                                alt="Partner 2"
                                                                class="img-fluid partner-logo-colored"
                                                        />
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-6">
                                                    <div class="partner-logo-container">
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/logo3.png"
                                                                alt="Partner 3"
                                                                class="img-fluid partner-logo-default"
                                                        />
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/coloured-logo/logo-3.png"
                                                                alt="Partner 3"
                                                                class="img-fluid partner-logo-colored"
                                                        />
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-6">
                                                    <div class="partner-logo-container">
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/logo4.png"
                                                                alt="Partner 4"
                                                                class="img-fluid partner-logo-default"
                                                        />
                                                        <img
                                                                src="/website_ext/static/src/images/who-we-are-section/partners/coloured-logo/logo-4.png"
                                                                alt="Partner 4"
                                                                class="img-fluid partner-logo-colored"
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Our Expertise Section -->
                    <section class="service-features" id="expertise">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title-sub">Our Expertise</h2>
                                <p class="section-subtitle">To empower organizations by providing innovative, scalable,
                                    and cost-effective
                                    digital solutions that streamline operations and enhance productivity.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/moodle-lms">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-1.svg"
                                                 alt="system integration"/>
                                        </div>
                                        <h3 class="feature-title">System Integration</h3>
                                        <p class="feature-description">Ensuring seamless communication between diverse
                                            business
                                            platforms.
                                        </p>
                                    </a>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/web-application">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-2.svg"
                                                 alt="application development"/>
                                        </div>
                                        <h3 class="feature-title">Web Development</h3>
                                        <p class="feature-description">Crafting customized applications tailored to
                                            unique business
                                            needs.
                                        </p>
                                    </a>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/erp-solution">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-3.svg"
                                                 alt="open-source"/>
                                        </div>
                                        <h3 class="feature-title">Open-Source Solutions</h3>
                                        <p class="feature-description">Leveraging platforms like Odoo ERP and Moodle LMS
                                            to deliver flexible
                                            and robust solutions.
                                        </p>
                                    </a>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/mobile-application">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-4.svg"
                                                 alt="mob-icon"/>
                                        </div>
                                        <h3 class="feature-title">Mobile App Development</h3>
                                        <p class="feature-description">Creating user-friendly mobile applications to
                                            engage customers
                                            effectively.
                                        </p>
                                    </a>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/moodle-lms">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-5.svg"
                                                 alt="e-learning"/>
                                        </div>
                                        <h3 class="feature-title">E-Learning Solutions</h3>
                                        <p class="feature-description">Developing comprehensive e-learning platforms to
                                            facilitate modern
                                            education and training needs.
                                        </p>
                                    </a>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <a class="feature-card" href="/ui-ux">
                                        <div class="feature-icon">
                                            <img src="/website_ext/static/src/images/about-us/about-6.svg"
                                                 alt="ui-ux-design"/>
                                        </div>
                                        <h3 class="feature-title">UI/UX Design</h3>
                                        <p class="feature-description">Designing clean, user-friendly interfaces that
                                            enhance usability,
                                            engagement, and brand experience.
                                        </p>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Our Reach & Culture Section -->
                    <section class="our-team">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title-sub">Our Reach &amp; Culture</h2>
                                <p class="section-subtitle">With offices in Riyadh, KSA, and Islamabad, Pakistan,
                                    InterCraft serves a global
                                    clientele with innovative solutions. Our culture is the foundation of our success,
                                    built on:
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-4 col-md-4 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                            </svg>
                                        </div>
                                        <h3 class="feature-title">Continuous Learning</h3>
                                        <p class="feature-description">Encouraging growth through ongoing training and
                                            development.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                            </svg>
                                        </div>
                                        <h3 class="feature-title">Team Spirit</h3>
                                        <p class="feature-description">Building strong relationships through team
                                            activities and shared
                                            goals.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            </svg>
                                        </div>
                                        <h3 class="feature-title">Work-Life Balance</h3>
                                        <p class="feature-description">Promoting a healthy balance to ensure sustained
                                            productivity and
                                            well-being.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Join Our Team Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Join Our Team</h2>
                                <p class="innovate-subtitle">Join our team of passionate innovators and help shape the
                                    digital future.
                                </p>
                                <a href="/career" class="get-started-btn">Apply Now</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_about_us" model="website.menu">
        <field name="name">about_us</field>
        <field name="url">/aboutus</field>
        <field name="page_id" ref="website_ext.aboutus"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>
