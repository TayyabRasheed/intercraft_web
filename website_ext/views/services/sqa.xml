<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sqa" model="website.page">
        <field name="name">SQA</field>
        <field name="type">qweb</field>
        <field name="url">/sqa</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.sqa</field>
        <field name="arch" type="xml">
            <t name="SQA" t-name="website_ext.sqa">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero sqa-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Ensure Excellence with Expert SQA Solutions
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Skilled QA professionals manage functional, automated,
                                            and performance testing—seamlessly integrated into your
                                            development process—to ensure a stable, scalable product
                                            that meets the highest quality standards.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Software Quality Assurance</span>
                                        <h2 class="service-title-services">Reliable QA, Better Software</h2>
                                        <p class="service-description-services">
                                            Eliminate bugs, delays, and unreliable releases with our end-to-end
                                            SQA services—including manual testing, automation, performance testing,
                                            and QA consulting. Whether you're launching a new product or improving
                                            an existing one, we align QA with your goals to boost reliability, user
                                            satisfaction, and time to market.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/sqa/sqa_about.png"
                                                alt="AI Expert"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- InterCraft at a Glance Section -->
                    <section class="at-a-glance">
                        <div class="container">
                            <div class="glance-content">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">
                                        <h2 class="glance-title">InterCraft at a Glance</h2>
                                        <p class="glance-description">
                                            Explore how we simplify business with smart solutions—from LMS
                                            and Odoo to custom app development.
                                        </p>
                                        <p class="glance-description">
                                            Download our info sheet to see how we drive digital
                                            transformation.
                                        </p>
                                        <a href="#" class="download-btn">
                                            Download
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    fill="currentColor"
                                                    class="bi bi-arrow-right"
                                                    viewBox="0 0 16 16"
                                            >
                                                <path
                                                        fill-rule="evenodd"
                                                        d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="document-illustration">
                                            <img
                                                    src="/website_ext/static/src/images/glance.png"
                                                    alt="Document Illustration"
                                                    class="img-fluid"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- AI Features Section -->
                    <section class="ai-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="ai-features-title">Optimize Quality, Accelerate Delivery</h2>
                                <p class="ai-features-subtitle">
                                    We provide comprehensive QA solutions tailored to your product and development
                                    workflow. From manual and automated testing to performance validation,
                                    our services ensure your software is reliable, secure, and user-ready.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/sp.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/coloured/sp1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Manual Testing</h3>
                                        <p class="feature-description">
                                            We uncover real-world issues with precision—covering functional, regression,
                                            UI/UX, and exploratory testing across browsers and devices.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/gearalt.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/coloured/gearalt1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Automated Testing</h3>
                                        <p class="feature-description">
                                            Accelerate releases with automation tailored to your tech stack—using
                                            Selenium, Cypress, Playwright, Appium, API automation, CI/CD integration,
                                            and BDD frameworks.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/ar.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/coloured/ar1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Performance Testing</h3>
                                        <p class="feature-description">
                                            Ensure your systems remain fast, stable, and scalable under any
                                            demand—through load testing, stress testing, spike testing, and response
                                            time optimization.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/lock.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/coloured/lock1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Security Testing</h3>
                                        <p class="feature-description">
                                            Build trust by keeping your applications secure with OWASP compliance,
                                            vulnerability scanning, API security, and penetration testing support.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/ey.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/sqa/coloured/ey1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">QA Strategy &amp; Consulting</h3>
                                        <p class="feature-description">
                                            We don’t just test—we embed quality into your product from day one with test
                                            strategy, shift-left QA, Agile/DevOps practices, QA audits, and actionable
                                            reporting.
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    <!-- Our Team Section -->
                    <section class="our-team">
                        <div class="container">
                            <div class="text-center mb-4">
                                <h2 class="section-title-sub">Our Team</h2>
                                <p class="section-subtitle">
                                    A passionate group of expert driving innovation, collaboration, and
                                    results.
                                </p>
                            </div>
                            <div
                                    id="teamCarousel"
                                    class="carousel slide"
                                    data-bs-ride="carousel"
                                    data-bs-interval="4000"
                            >
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="row justify-content-center">
                                            <div class="col-lg-3 col-md-6 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/senior-sqa.jpg"
                                                                alt="Eshrat-Ul-Islam"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Eshrat-Ul-Islam</h4>
                                                        <p class="team-role">Senior SQA Engineer</p>
                                                        <a href="https://www.linkedin.com/in/eshrat-ul-islam/
 " class="team-social"  target="_blank">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/sqa-analyst.jpg"
                                                                alt="Usman Waheed"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Usman Waheed</h4>
                                                        <p class="team-role">SQA Engineer</p>
                                                        <a href="https://www.linkedin.com/in/muhammad-usman-waheed-549290247/"
                                                           class="team-social"  target="_blank">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Carousel Indicators (Dots) -->
<!--                                <div class="carousel-indicators team-indicators">-->
<!--                                    <button-->
<!--                                            type="button"-->
<!--                                            data-bs-target="#teamCarousel"-->
<!--                                            data-bs-slide-to="0"-->
<!--                                            class="active"-->
<!--                                            aria-current="true"-->
<!--                                            aria-label="Slide 1"-->
<!--                                    />-->
<!--                                    <button-->
<!--                                            type="button"-->
<!--                                            data-bs-target="#teamCarousel"-->
<!--                                            data-bs-slide-to="1"-->
<!--                                            aria-label="Slide 2"-->
<!--                                    />-->
<!--                                    <button-->
<!--                                            type="button"-->
<!--                                            data-bs-target="#teamCarousel"-->
<!--                                            data-bs-slide-to="2"-->
<!--                                            aria-label="Slide 3"-->
<!--                                    />-->
<!--                                </div>-->
                            </div>
                        </div>
                    </section>

                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Innovate?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to turn your ideas into intelligent AI solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_sqa" model="website.menu">
        <field name="name">sqa</field>
        <field name="url">/sqa</field>
        <field name="page_id" ref="website_ext.sqa"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>