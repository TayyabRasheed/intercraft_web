<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud-services" model="website.page">
        <field name="name">Cloud Services</field>
        <field name="type">qweb</field>
        <field name="url">/cloud-services</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.cloud-services</field>
        <field name="arch" type="xml">
            <t name="Cloud Services" t-name="website_ext.cloud-services">
                <t t-call="website.layout">
                    <!-- Hero Section -->
                    <section class="service-hero ai-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Transform Business with Cutting-Edge AI Solutions
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Automate, optimize, and innovate with tailored AI services
                                            designed to accelerate growth and efficiency.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">AI Solutions</span>
                                        <h2 class="service-title-services">Smarter Systems Start with AI</h2>
                                        <p class="service-description-services">
                                            Unlock the power of artificial intelligence to streamline
                                            operations, enhance decision-making, and deliver smarter
                                            customer experiences.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/ai-expert/chat-ai.png"
                                                alt="AI Expert"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- InterCraft at a Glance Section -->
                    <section class="at-a-glance">
                        <div class="container">
                            <div class="glance-content">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">
                                        <h2 class="glance-title">InterCraft at a Glance</h2>
                                        <p class="glance-description">
                                            Explore how we simplify business with smart solutions—from LMS
                                            and Odoo to custom app development.
                                        </p>
                                        <p class="glance-description">
                                            Download our info sheet to see how we drive digital
                                            transformation.
                                        </p>
                                        <a href="#" class="download-btn">
                                            Download
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    fill="currentColor"
                                                    class="bi bi-arrow-right"
                                                    viewBox="0 0 16 16"
                                            >
                                                <path
                                                        fill-rule="evenodd"
                                                        d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="document-illustration">
                                            <img
                                                    src="/website_ext/static/src/images/glance.png"
                                                    alt="Document Illustration"
                                                    class="img-fluid"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- AI Features Section -->
                    <section class="ai-features">
                         <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/BG_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="ai-features-title">AI That Drives Results</h2>
                                <p class="ai-features-subtitle">
                                    Our custom-built AI solutions—powered by machine learning, NLP, and
                                    deep learning—go beyond automation. They learn, adapt, and evolve
                                    with your business. Make smarter decisions. Streamline operations.
                                    Stay ahead—automatically.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/voicemail.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">AI Voice Assistant</h3>
                                        <p class="feature-description">
                                            Let your customers talk—and be heard. Our voice assistants
                                            handle queries naturally and in real-time, so your support team
                                            can breathe easy.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/customize-chatbots.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Customized Chatbot</h3>
                                        <p class="feature-description">
                                            Our smart, branded chatbots are ready 24/7 to deliver answers
                                            that feel human—with the accuracy and speed only AI can provide.
                                            Instant responses.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/response-bots.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Response Bots</h3>
                                        <p class="feature-description">
                                            Our AI-driven response bots handle repetitive queries with speed
                                            and consistency—learning and improving with every interaction.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/phone-call.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Call Evaluations</h3>
                                        <p class="feature-description">
                                            AI that truly hears your customers. We analyze calls for tone,
                                            sentiment, and performance—delivering instant insights, not
                                            hours of review.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/mail-star.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Email Co-Pilot</h3>
                                        <p class="feature-description">
                                            Inbox overload? Not anymore. Our AI co-pilot drafts and manages
                                            emails so your team can focus on what matters most.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/microphone-alt-1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Voice Intelligence</h3>
                                        <p class="feature-description">
                                            Conversations hold power—our AI unlocks it. Dive deep into your
                                            voice data to uncover trends, sentiments, and insights that
                                            drive strategy.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/business-automation.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon7.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">​Business Automation</h3>
                                        <p class="feature-description">
                                            We automate routine tasks across departments so your team can
                                            focus on impact, not repetition.Flawless workflows. Faster
                                            results. Zero burnout.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Our Team Section -->
                    <section class="our-team">
                        <div class="container">
                            <div class="text-center mb-4">
                                <h2 class="section-title-sub">Our Team</h2>
                                <p class="section-subtitle">
                                    A passionate group of expert driving innovation, collaboration, and
                                    results.
                                </p>
                            </div>
                            <div
                                    id="teamCarousel"
                                    class="carousel slide"
                                    data-bs-ride="carousel"
                                    data-bs-interval="4000"
                            >
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="row justify-content-center">
                                             <div class="col-lg-3 col-md-6 mb-4">
                                    <div class="team-card">
                                        <div class="team-image">
                                            <img
                                                    src="/website_ext/static/src/images/team/cloud.png"
                                                    alt="Ghulam Mujtaba"
                                                    class="img-fluid"
                                            />
                                        </div>
                                        <div class="team-info">
                                            <h4 class="team-name">Ghulam Mujtaba</h4>
                                            <p class="team-role">Cloud and DevOps Engineer</p>
                                            <a href="https://www.linkedin.com/in/alyzeh-fatymah-51b81b263/"
                                               class="team-social">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="16"
                                                        height="16"
                                                        viewBox="0 0 24 24"
                                                        fill="white"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                >
                                                    <path
                                                            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                    />
                                                    <rect width="4" height="12" x="2" y="9"/>
                                                    <circle cx="4" cy="4" r="2"/>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Carousel Indicators (Dots) -->
                                <div class="carousel-indicators team-indicators">
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="0"
                                            class="active"
                                            aria-current="true"
                                            aria-label="Slide 1"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="1"
                                            aria-label="Slide 2"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="2"
                                            aria-label="Slide 3"
                                    />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Innovate?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to turn your ideas into intelligent AI solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_cloud-services" model="website.menu">
        <field name="name">cloud-services</field>
        <field name="url">/cloud-services</field>
        <field name="page_id" ref="website_ext.cloud-services"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>