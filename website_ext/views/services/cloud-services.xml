<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cloud-services" model="website.page">
        <field name="name">Cloud Services</field>
        <field name="type">qweb</field>
        <field name="url">/cloud-services</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.cloud-services</field>
        <field name="arch" type="xml">
            <t name="Cloud Services" t-name="website_ext.cloud-services">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero cloud-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Accelerate Innovation with Scalable Cloud Solutions
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Robust, secure, and scalable cloud solutions designed to support modern
                                            business needs. From architecture to deployment, our cloud engineering
                                            services optimize performance, reduce costs, and enable agility across your
                                            infrastructure
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Cloud Engineering</span>
                                        <h2 class="service-title-services">Cloud Solutions Built for Scale and Agility
                                        </h2>
                                        <p class="service-description-services">
                                            n today’s digital-first world, scalable and secure cloud infrastructure is
                                            critical to staying competitive. Yet many organizations struggle with
                                            complex cloud environments and rising costs. Our Cloud Engineering services
                                            simplify this journey—delivering customized, reliable, and cost-effective
                                            solutions that support innovation, agility, and long-term growth.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/cloud/cloud_about.png"
                                                alt="AI Expert"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- InterCraft at a Glance Section -->
                    <section class="at-a-glance">
                        <div class="container">
                            <div class="glance-content">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">
                                        <h2 class="glance-title">InterCraft at a Glance</h2>
                                        <p class="glance-description">
                                            Explore how we simplify business with smart solutions—from LMS
                                            and Odoo to custom app development.
                                        </p>
                                        <p class="glance-description">
                                            Download our info sheet to see how we drive digital
                                            transformation.
                                        </p>
                                        <a href="#" class="download-btn">
                                            Download
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    fill="currentColor"
                                                    class="bi bi-arrow-right"
                                                    viewBox="0 0 16 16"
                                            >
                                                <path
                                                        fill-rule="evenodd"
                                                        d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="document-illustration">
                                            <img
                                                    src="/website_ext/static/src/images/glance.png"
                                                    alt="Document Illustration"
                                                    class="img-fluid"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- AI Features Section -->
                    <section class="ai-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="ai-features-title">Modernize Infrastructure, Maximize Agility</h2>
                                <p class="ai-features-subtitle">
                                    We provide end-to-end cloud engineering services tailored to your business and
                                    technical needs. From architecture design to deployment and optimization, we ensure
                                    your cloud infrastructure is secure, high-performing, and built to scale.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/cloud.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/cloud1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Cloud Architecture Design</h3>
                                        <p class="feature-description">
                                            We design robust cloud architectures aligned with your business goals,
                                            ensuring flexibility, security, and efficiency.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/arrow.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/arrow1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Cloud Migration</h3>
                                        <p class="feature-description">
                                            Smoothly transition from legacy infrastructure to the cloud with minimal
                                            downtime and zero data loss.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/cloudlock.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/cloudlock1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Cloud Security &amp; Compliance</h3>
                                        <p class="feature-description">
                                            Implement best-in-class security practices and compliance measures to
                                            protect your assets and maintain regulatory standards.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/gear.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/gear1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Cloud Optimization</h3>
                                        <p class="feature-description">
                                            Maximize performance and reduce costs with continuous monitoring, resource
                                            right-sizing, and usage analytics.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/refresh.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/refresh1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">DevOps &amp; Automation</h3>
                                        <p class="feature-description">
                                            Streamline development and deployment through infrastructure automation and
                                            CI/CD pipelines.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/clouds.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/cloud/coloured/clouds1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Multi-Cloud &amp; Hybrid Cloud Solutions</h3>
                                        <p class="feature-description">
                                            Design and manage flexible architectures that work across AWS, Azure, GCP,
                                            or on-prem environments.
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    <!-- Our Team Section -->
                    <section class="our-team">
                        <div class="container">
                            <div class="text-center mb-4">
                                <h2 class="section-title-sub">Our Team</h2>
                                <p class="section-subtitle">
                                    A passionate group of expert driving innovation, collaboration, and
                                    results.
                                </p>
                            </div>
                            <div
                                    id="teamCarousel"
                                    class="carousel slide"
                                    data-bs-ride="carousel"
                                    data-bs-interval="4000"
                            >
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="row justify-content-center">
                                            <div class="col-lg-3 col-md-6 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/cloud.png"
                                                                alt="Ghulam Mujtaba"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Ghulam Mujtaba</h4>
                                                        <p class="team-role">Cloud and DevOps Engineer</p>
                                                        <a href="https://www.linkedin.com/in/alyzeh-fatymah-51b81b263/"
                                                           class="team-social">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Carousel Indicators (Dots) -->
                                <div class="carousel-indicators team-indicators">
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="0"
                                            class="active"
                                            aria-current="true"
                                            aria-label="Slide 1"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="1"
                                            aria-label="Slide 2"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="2"
                                            aria-label="Slide 3"
                                    />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Innovate?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to turn your ideas into intelligent AI solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_cloud-services" model="website.menu">
        <field name="name">cloud-services</field>
        <field name="url">/cloud-services</field>
        <field name="page_id" ref="website_ext.cloud-services"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>