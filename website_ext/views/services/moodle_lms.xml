<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="moodle-lms" model="website.page">
        <field name="name">Moodle LMS</field>
        <field name="type">qweb</field>
        <field name="url">/moodle-lms</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.moodle-lms</field>
        <field name="arch" type="xml">
            <t name="Moodle LMS" t-name="website_ext.moodle-lms">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <section class="service-hero moodle-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Empower Learning with Our Advanced Moodle LMS
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Seamlessly deliver, manage, and track education and training
                                            with a fully customized, scalable, and user-friendly Moodle
                                            solution designed for modern institutions.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-details">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Moodle LMS Solutions</span>
                                        <h2 class="service-title-services">Modern Learning, Powered by Moodle</h2>
                                        <p class="service-description-services">
                                            Deliver engaging, scalable, and remote-friendly training with
                                            our tailored Moodle solutions. From setup to support, we
                                            customize everything—platform, plugins, mobile apps—to match
                                            your learning needs.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image d-none d-sm-block">
                                        <img
                                                src="/website_ext/static/src/images/services-section/moodle-lms/moodle-side-image.png"
                                                alt="Moodle LMS"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-features">

                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title_sub">Our Moodle LMS Services</h2>
                                <p class="section-subtitle">
                                    Whether you're starting fresh or enhancing an existing platform, our
                                    expert Moodle team is here to support you with everything from setup
                                    and customization to integration, mobile app development, and
                                    ongoing maintenance. We help you unlock the full potential of
                                    Moodle—today and as your learning needs evolve.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moodle-customization.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Installation &amp; Setup</h3>
                                        <p class="feature-description">
                                            Complete installation and environment optimization for
                                            on-premise or cloud-hosted Moodle platforms.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moodle-installation-icon.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Customization</h3>
                                        <p class="feature-description">
                                            Personalized themes, plugins, and course layouts aligned with
                                            your branding and learning strategies.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moode-integration.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Integration</h3>
                                        <p class="feature-description">
                                            Seamless connections with external systems such as SIS, CRMs,
                                            payment gateways, and analytics tools.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moodle-mig.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Migration</h3>
                                        <p class="feature-description">
                                            Secure and seamless migration from existing LMS platforms to
                                            Moodle with minimal disruption.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moodle-main.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Support &amp; Maintenance</h3>
                                        <p class="feature-description">
                                            Ongoing updates, security checks, and technical support to
                                            ensure consistent performance.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/moodle-mobile.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/moodle-lms/coloured/moodle-6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Moodle Mobile App Development</h3>
                                        <p class="feature-description">
                                            Enabling learners to access training anytime, anywhere through a
                                            responsive mobile app.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_moodle_lms" model="website.menu">
        <field name="name">moodle-lms</field>
        <field name="url">/moodle-lms</field>
        <field name="page_id" ref="website_ext.moodle-lms"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>