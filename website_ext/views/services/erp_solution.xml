<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="erp-solution" model="website.page">
        <field name="name">ERP Solution</field>
        <field name="type">qweb</field>
        <field name="url">/erp-solution</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.erp-solution</field>
        <field name="arch" type="xml">
            <t name="ERP Solution" t-name="website_ext.erp-solution">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero erp-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Streamline Operations with Expert Odoo Services
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Our certified experts manage setup, migration, and
                                            customization—without hardcoding—ensuring a flexible, fully
                                            integrated solution that scales with your business.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">ERP Solutions</span>
                                        <h2 class="service-title-services">Comprehensive Odoo ERP Services</h2>
                                        <p class="service-description-services">
                                            Say goodbye to scattered systems and inefficiencies. Our
                                            end-to-end Odoo solutions—implementation, customization,
                                            integration, and support—bring everything under one roof.
                                            Whether you're starting fresh or improving an existing setup, we
                                            tailor Odoo to fit your business goals—boosting automation,
                                            visibility, and performance across the board.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/erp-solution/erp-section.png"
                                                alt="ERP Solutions"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- InterCraft at a Glance Section -->
                    <section class="at-a-glance">
                        <div class="container">
                            <div class="glance-content">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">
                                        <h2 class="glance-title">InterCraft at a Glance</h2>
                                        <p class="glance-description">
                                            Explore how we simplify business with smart solutions—from LMS
                                            and Odoo to custom app development.
                                        </p>
                                        <p class="glance-description">
                                            Download our info sheet to see how we drive digital
                                            transformation.
                                        </p>
                                        <a href="#" class="download-btn">
                                            Download
                                            <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    fill="currentColor"
                                                    class="bi bi-arrow-right"
                                                    viewBox="0 0 16 16"
                                            >
                                                <path
                                                        fill-rule="evenodd"
                                                        d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="document-illustration">
                                            <img
                                                    src="/website_ext/static/src/images/glance.png"
                                                    alt="Document Illustration"
                                                    class="img-fluid"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Service Features Section -->
                    <section class="service-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/BG_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title">Simplify, Automate, and Scale with Odoo</h2>
                                <p class="section-subtitle">
                                    Take control of your operations with a fully integrated Odoo ERP
                                    system. From sales and inventory to HR and finance, we help you
                                    streamline workflows, eliminate data silos, and automate routine
                                    tasks. Our tailored Odoo services ensure your business runs
                                    smoother, faster, and smarter—so you can focus on growth, not
                                    complexity.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/odoo-implementation.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Odoo ERP Implementation</h3>
                                        <p class="feature-description">
                                            We implement Odoo to fit your workflows and structure, ensuring
                                            smooth and efficient adoption.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/odoo-customization.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Odoo Customization</h3>
                                        <p class="feature-description">
                                            Our experts customize existing Odoo modules or build new ones
                                            tailored to your business processes, enabling optimal
                                            functionality and increased efficiency.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/odoo-migation.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Odoo Migration</h3>
                                        <p class="feature-description">
                                            We ensure smooth, secure migrations from old systems or Odoo
                                            versions, preserving data and minimizing downtime.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/odoo-intergration.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Odoo Integration</h3>
                                        <p class="feature-description">
                                            We integrate Odoo with key tools like CRM and payment systems to
                                            eliminate silos and streamline operations.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/maintaince.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/erp-solution/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Odoo Support and Maintenance</h3>
                                        <p class="feature-description">
                                            We offer ongoing support, optimization, and updates to keep your
                                            Odoo running smoothly and growing with your business.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Our Team Section -->
                    <section class="our-team">
                        <div class="container">
                            <div class="text-center mb-4">
                                <h2 class="section-title-sub">Our Team</h2>
                                <p class="section-subtitle">
                                    A passionate group of experts driving innovation, collaboration, and
                                    results.
                                </p>
                            </div>
                            <div
                                    id="teamCarousel"
                                    class="carousel slide"
                                    data-bs-ride="carousel"
                                    data-bs-interval="4000"
                            >
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="row justify-content-center">
                                            <div class="col-lg-3 col-md-4 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/odoo-lead.jpg"
                                                                alt="Tayyab Rasheed"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Tayyab Rasheed</h4>
                                                        <p class="team-role">Senior Software Engineer (Odoo Technical Lead)</p>
                                                        <a href="https://www.linkedin.com/in/tayyab-rasheed-465522105/" class="team-social">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/senior-odoo.jpg"
                                                                alt="Javaid Khan"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Javaid Khan</h4>
                                                        <p class="team-role">Senior Odoo Developer</p>
                                                        <a href="https://www.linkedin.com/in/javaid-khan-4971a6221" class="team-social">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 mb-4">
                                                <div class="team-card">
                                                    <div class="team-image">
                                                        <img
                                                                src="/website_ext/static/src/images/team/kashan.jpg"
                                                                alt="Kashan"
                                                                class="img-fluid"
                                                        />
                                                    </div>
                                                    <div class="team-info">
                                                        <h4 class="team-name">Syed Kashan Ali</h4>
                                                        <p class="team-role">Senior Functional Consultant</p>
                                                        <a href="www.linkedin.com/in/syed-kashan-ali-ab28b7213" class="team-social">
                                                            <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    width="16"
                                                                    height="16"
                                                                    viewBox="0 0 24 24"
                                                                    fill="white"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                            >
                                                                <path
                                                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                                                />
                                                                <rect width="4" height="12" x="2" y="9"/>
                                                                <circle cx="4" cy="4" r="2"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Carousel Indicators (Dots) -->
                                <div class="carousel-indicators team-indicators">
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="0"
                                            class="active"
                                            aria-current="true"
                                            aria-label="Slide 1"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="1"
                                            aria-label="Slide 2"
                                    />
                                    <button
                                            type="button"
                                            data-bs-target="#teamCarousel"
                                            data-bs-slide-to="2"
                                            aria-label="Slide 3"
                                    />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Innovate?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to transform your business with powerful ERP
                                    solutions.
                                </p>
                                <a href="/contactus" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_erp_solution" model="website.menu">
        <field name="name">erp-solution</field>
        <field name="url">/erp-solution</field>
        <field name="page_id" ref="website_ext.erp-solution"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>