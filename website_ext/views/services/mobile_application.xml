<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mobile-application" model="website.page">
        <field name="name">Mobile Application</field>
        <field name="type">qweb</field>
        <field name="url">/mobile-application</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.mobile-application</field>
        <field name="arch" type="xml">
            <t name="Mobile Application" t-name="website_ext.mobile-application">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero mobile-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">Mobile Application Development</h1>
                                        <p class="service-hero-subtitle">
                                            Powerful Mobile Apps Tailored for Your Business
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Mobile Applications</span>
                                        <h2 class="service-title-services">
                                            Mobile Apps That Help Your Business Grow
                                        </h2>
                                        <p class="service-description-services">
                                            Today, people use their phones for almost everything. Having a simple,
                                            easy-to-use mobile app is important to connect with your customers anywhere,
                                            anytime. We create modern, fast, and reliable mobile apps that make your
                                            brand stronger, keep your customers happy, and make your work easier.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/mobile-applications/mobile-app-service.png"
                                                alt="Mobile Applications"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Features Section -->
                    <section class="service-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title">Our Mobile Application Services</h2>
                                <p class="section-subtitle">
                                    Build seamless, high-performance mobile experiences with expert
                                    native and cross-platform development—designed to engage users and
                                    drive growth.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Custom Mobile App Development</h3>
                                        <p class="feature-description">
                                            Design and development of tailored apps to meet unique business
                                            needs, whether for commerce, productivity, or enterprise use.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon2.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Cross-Platform Mobile Apps</h3>
                                        <p class="feature-description">
                                            Use of technologies like React Native and Flutter to build
                                            high-performance apps that run smoothly on both iOS and Android.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon3.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Native iOS &amp; Android Apps</h3>
                                        <p class="feature-description">
                                            Development of platform-specific applications for iOS (Swift)
                                            and Android (Kotlin/Java) to maximize performance and user
                                            experience.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon4.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">UI/UX Design for Mobile Apps</h3>
                                        <p class="feature-description">
                                            Creation of intuitive, visually appealing interfaces that ensure
                                            seamless navigation and a top-tier user experience.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon5.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Mobile App Integration</h3>
                                        <p class="feature-description">
                                            Integration with backend systems, APIs, and third-party
                                            platforms to enhance app functionality and enable smooth data
                                            exchange.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/icon6.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/mobile-applications/coloured/icon6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">App Maintenance &amp; Updates</h3>
                                        <p class="feature-description">
                                            Ongoing maintenance, updates, and performance tuning to ensure
                                            your app stays secure, efficient, and relevant.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>



                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_mobile_application" model="website.menu">
        <field name="name">mobile-application</field>
        <field name="url">/mobile-application</field>
        <field name="page_id" ref="website_ext.mobile-application"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>