<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="web-application" model="website.page">
        <field name="name">Web Application</field>
        <field name="type">qweb</field>
        <field name="url">/web-application</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.web-application</field>
        <field name="arch" type="xml">
            <t name="Web Application" t-name="website_ext.web-application">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <section class="service-hero web-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Website Application Development
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Scalable, responsive, and user-centric web solutions built to
                                            enhance your brand and streamline your operations.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Web Application</span>
                                        <h2 class="service-title-services">Web Applications That Drive Results</h2>
                                        <p class="service-description-services">
                                            In today’s digital landscape, a strong, user-friendly web
                                            presence is essential for staying ahead. Yet many businesses
                                            still rely on outdated websites or applications that fall short
                                            on functionality and user experience. Our web application
                                            development service bridges this gap with responsive, scalable,
                                            and high-performing solutions that enhance your brand and
                                            streamline operations.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/web-applications/web-app-service.png"
                                                alt="web applications"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title">Our Web Application Services</h2>
                                <p class="section-subtitle">
                                    We build modern, high-performance web applications tailored to your
                                    business goals. From sleek, responsive designs to powerful backend
                                    functionality, our solutions ensure seamless user experiences and
                                    reliable performance across devices..
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Custom Website Development</h3>
                                        <p class="feature-description">
                                            We craft custom websites that reflect your brand and deliver
                                            intuitive, engaging user experiences—tailored to your business
                                            goals.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon2.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">E-commerce Solutions</h3>
                                        <p class="feature-description">
                                            We create secure, scalable e-commerce platforms that not only
                                            drive online sales but also offer a seamless and enjoyable
                                            shopping experience.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon3.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Content Management Systems (CMS)</h3>
                                        <p class="feature-description">
                                            Our CMS solutions empower you to manage website content easily
                                            with intuitive interfaces and a robust backend.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon4.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Web Application Development</h3>
                                        <p class="feature-description">
                                            We build custom web applications tailored to your business
                                            processes, enabling better workflow integration, task
                                            automation, and improved data management.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon5.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon5.svg "
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Responsive Web Design</h3>
                                        <p class="feature-description">
                                            We design responsive websites that deliver a seamless,
                                            high-performance experience across all devices, enhancing user
                                            engagement and retention.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/icon6.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/web-applications/coloured/icon6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">API Integration and Development</h3>
                                        <p class="feature-description">
                                            Enhance your application's capabilities by integrating
                                            third-party services or developing custom APIs.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>

                </t>
            </t>
        </field>
    </record>
    <record id="menu_web_application" model="website.menu">
        <field name="name">web-application</field>
        <field name="url">/web-application</field>
        <field name="page_id" ref="website_ext.web-application"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>