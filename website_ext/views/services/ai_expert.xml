<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai-expert" model="website.page">
        <field name="name">AI Expert</field>
        <field name="type">qweb</field>
        <field name="url">/ai-expert</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.ai-expert</field>
        <field name="arch" type="xml">
            <t name="About Us Page" t-name="website_ext.ai-expert">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero ai-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">
                                            Transform Business with Cutting-Edge AI Solutions
                                        </h1>
                                        <p class="service-hero-subtitle">
                                            Automate, optimize, and innovate with tailored AI services
                                            designed to accelerate growth and efficiency.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Artificial Intelligence Transformation</span>
                                        <h2 class="service-title-services">Smarter Systems Start with AI</h2>
                                        <p class="service-description-services">
                                            Unlock the power of artificial intelligence to streamline
                                            operations, enhance decision-making, and deliver smarter
                                            customer experiences.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                                src="/website_ext/static/src/images/services-section/ai-expert/chat-ai.png"
                                                alt="AI Expert"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- AI Features Section -->
                    <section class="ai-features">
                        <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="ai-features-title">AI That Drives Results</h2>
                                <p class="ai-features-subtitle">
                                    Our custom-built AI solutions—powered by machine learning, NLP, and
                                    deep learning—go beyond automation. They learn, adapt, and evolve
                                    with your business. Make smarter decisions. Streamline operations.
                                    Stay ahead—automatically.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/voicemail.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">AI Voice Assistant</h3>
                                        <p class="feature-description">
                                            Let your customers talk—and be heard. Our voice assistants
                                            handle queries naturally and in real-time, so your support team
                                            can breathe easy.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/customize-chatbots.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Customized Chatbot</h3>
                                        <p class="feature-description">
                                            Our smart, branded chatbots are ready 24/7 to deliver answers
                                            that feel human—with the accuracy and speed only AI can provide.
                                            Instant responses.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/response-bots.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Response Bots</h3>
                                        <p class="feature-description">
                                            Our AI-driven response bots handle repetitive queries with speed
                                            and consistency—learning and improving with every interaction.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/phone-call.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Call Evaluations</h3>
                                        <p class="feature-description">
                                            AI that truly hears your customers. We analyze calls for tone,
                                            sentiment, and performance—delivering instant insights, not
                                            hours of review.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/mail-star.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Email Co-Pilot</h3>
                                        <p class="feature-description">
                                            Inbox overload? Not anymore. Our AI co-pilot drafts and manages
                                            emails so your team can focus on what matters most.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/microphone-alt-1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Voice Intelligence</h3>
                                        <p class="feature-description">
                                            Conversations hold power—our AI unlocks it. Dive deep into your
                                            voice data to uncover trends, sentiments, and insights that
                                            drive strategy.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/business-automation.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/ai-expert/coloured/icon7.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">​Business Automation</h3>
                                        <p class="feature-description">
                                            We automate routine tasks across departments so your team can
                                            focus on impact, not repetition.Flawless workflows. Faster
                                            results. Zero burnout.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_ai_expert" model="website.menu">
        <field name="name">ai-expert</field>
        <field name="url">/ai-expert</field>
        <field name="page_id" ref="website_ext.ai-expert"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>