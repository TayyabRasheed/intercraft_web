<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ui-ux" model="website.page">
        <field name="name">UI UX</field>
        <field name="type">qweb</field>
        <field name="url">/ui-ux</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.ui-ux</field>
        <field name="arch" type="xml">
            <t name="UI UX" t-name="website_ext.ui-ux">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <section class="service-hero uiux-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">UI/UX Design</h1>
                                        <p class="service-hero-subtitle">
                                            We blend design thinking, user insight, and innovation to deliver seamless digital products that solve real problems, enhance usability, and accelerate business growth
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">UI/UX Design </span>
                                        <h2 class="service-title-services">User Experience Design Matters</h2>
                                        <p class="service-description-services">
                                            First impressions are everything. In the digital world, your
                                            user interface and user experience define how your audience
                                            feels about your product. Great design isn't just beautiful —
                                            it's intuitive, accessible, and impactful. We combine design
                                            thinking, user research, and aesthetic precision to create
                                            digital experiences that drive results.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image">
                                        <img
                                               src="/website_ext/static/src/images/services-section/moodle-lms/moodle-side-image.png"
                                                alt="Moodle LMS"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="service-features">
                         <div class="services-bg d-none d-md-block">
                            <img src="/website_ext/static/src/images/bg_image.png" alt="service_sec"
                                 aria-hidden="true"/>
                        </div>
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title-sub">Our UI/UX Design Services</h2>
                                <p class="section-subtitle">
                                    A custom-crafted design system and High-fidelity mockups with
                                    interactive prototypes.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/icon1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">User Research &amp; Discovery</h3>
                                        <p class="feature-description">
                                            We dive deep to understand your users — their goals, behaviors,
                                            and pain points — so we can design with empathy and insight.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/icon2.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">
                                            UX Strategy &amp; Information Architecture
                                        </h3>
                                        <p class="feature-description">
                                            We structure your content and interactions to create logical,
                                            user-friendly flows that reduce friction and increase
                                            engagement.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/icon3.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">UI Design &amp; Prototyping</h3>
                                        <p class="feature-description">
                                            We design stunning interfaces with a focus on usability, brand
                                            consistency, and micro-interactions that delight.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/icon4.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Responsive &amp; Adaptive Design</h3>
                                        <p class="feature-description">
                                            From mobile to desktop, we ensure your product looks and
                                            performs flawlessly across all devices.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/icon5.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                   src="/website_ext/static/src/images/services-section/ui-ux/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Usability Testing &amp; Iteration</h3>
                                        <p class="feature-description">
                                            We test, gather feedback, and refine until your users feel at
                                            home with your product.
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_ui_ux" model="website.menu">
        <field name="name">ui-ux</field>
        <field name="url">/ui-ux</field>
        <field name="page_id" ref="website_ext.ui-ux"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>