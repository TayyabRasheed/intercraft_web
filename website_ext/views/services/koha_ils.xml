<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="koha-ils" model="website.page">
        <field name="name">Koha ILS</field>
        <field name="type">qweb</field>
        <field name="url">/koha-ils</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.koha-ils</field>
        <field name="arch" type="xml">
            <t name="Koha ILS" t-name="website_ext.koha-ils">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero koha-hero">
                        <div class="service-hero-bg"/>
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">Koha ILS Solutions</h1>
                                        <p class="service-hero-subtitle">
                                            We offer tailored Koha ILS solutions that automate library workflows, enhance user experience, and simplify resource management for institutions of all sizes.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Details Section -->
                    <section class="service-details">

                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <div class="service-content">
                                        <span class="service-label">Koha ILS Solutions </span>
                                        <h2 class="service-title-services">Smarter Library Management</h2>
                                        <p class="service-description-services">
                                            Koha is the world’s first open-source Integrated Library System
                                            — robust, flexible, and trusted by thousands of libraries
                                            worldwide. We specialize in implementing, customizing, and
                                            supporting Koha to help you streamline operations, improve
                                            patron experiences, and embrace the power of modern, cloud-based
                                            library automation.
                                        </p>
                                        <a href="/contact-us" class="service-cta-btn"
                                        >Let's Connect
                                        </a
                                        >
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="service-image d-none d-sm-block">
                                        <img
                                                src="/website_ext/static/src/images/services-section/koha-ils/sideimage.png"
                                                alt="Moodle LMS"
                                                class="img-fluid"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Service Features Section -->
                    <section class="service-features">

                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title">Our Koha ILS Services</h2>
                                <p class="section-subtitle">
                                    Ready to modernize your library management with a flexible,
                                    future-ready system? Let our Koha experts guide you from setup to
                                    success.
                                </p>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon1.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon1.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Koha Installation &amp; Configuration</h3>
                                        <p class="feature-description">
                                            We handle full setup of the Koha ILS — from server provisioning
                                            to complete backend configuration, ensuring a smooth, secure,
                                            and scalable deployment.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon2.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon2.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Customization &amp; Module Tuning</h3>
                                        <p class="feature-description">
                                            Need features tailored to your workflow? We customize modules
                                            like circulation, cataloging, OPAC, patron management, and
                                            acquisitions to fit your exact needs.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon3.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon3.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Data Migration</h3>
                                        <p class="feature-description">
                                            Migrating from another ILS? We ensure a clean, accurate, and
                                            complete transfer of your existing records, bibliographic data,
                                            and user accounts into Koha.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon4.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon4.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Staff Training &amp; Documentation</h3>
                                        <p class="feature-description">
                                            We offer hands-on training for librarians, administrators, and
                                            technical staff — plus comprehensive documentation to keep your
                                            team confident and self-reliant.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon5.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon5.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Ongoing Support &amp; Maintenance</h3>
                                        <p class="feature-description">
                                            We provide regular updates, performance monitoring, security
                                            patches, and technical support so your Koha system runs reliably
                                            around the clock.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="feature-card">
                                        <div class="feature-icon">
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/icon6.svg"
                                                    alt="icon"
                                                    class="icon-default"
                                            />
                                            <img
                                                    src="/website_ext/static/src/images/services-section/koha-ils/coloured/icon6.svg"
                                                    alt="icon"
                                                    class="icon-colored"
                                            />
                                        </div>
                                        <h3 class="feature-title">Koha Hosting</h3>
                                        <p class="feature-description">
                                            Prefer a cloud-based setup? We offer secure, fully-managed Koha
                                            hosting with daily backups and guaranteed uptime.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Ready to Innovate Section -->
                    <section class="innovate">
                        <div class="container text-center">
                            <div class="innovate-content">
                                <h2 class="innovate-title">Ready to Craft?</h2>
                                <p class="innovate-subtitle">
                                    Let's collaborate to craft your ideas into intelligent and innovative
                                    solutions.
                                </p>
                                <a href="/contact-us" class="get-started-btn">Get Started</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_koha_ils" model="website.menu">
        <field name="name">koha-ils</field>
        <field name="url">/koha-ils</field>
        <field name="page_id" ref="website_ext.koha-ils"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>