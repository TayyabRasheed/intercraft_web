<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_side_contact_us" name="Side Contact Us Panel">
        <div id="portal_side_contact_us" class="d-none d-md-block">
            <a class="side-contact-btn_contact" id="contactToggleBtn">
<!--                    <img src="/website_ext/static/src/images/logo_white.svg" alt="icon"/>-->
                    <span>Let's Connect</span>

                </a>
            <div class="contact-form-overlay  " id="contactFormModal">
                <div class="contact-form-wrapper set_margin_top">
                    <a href="#" class="contact-close-btn" id="closeContactForm">×</a>
                    <h3 class="text-center">Contact Us</h3>
                    <div class="contact-form-body">
                        <t t-call="website.s_website_form"/>
                    </div>
                </div>
            </div>
        </div>
    </template>
        <template id="inject_manrope_font_side" inherit_id="website.layout" name="Inject Assets">
        <xpath expr="//body" position="inside">
            <script type="text/javascript" src="/website_ext/static/src/js/side_contact_us.js"/>

        </xpath>
    </template>
</odoo>
