<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="our-team" model="website.page">
        <field name="name">Our Team</field>
        <field name="type">qweb</field>
        <field name="url">/our-team</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.our-team</field>
        <field name="arch" type="xml">
            <t name="Our Team" t-name="website_ext.our-team">
                <t t-call="website.layout">
                    <t t-call="website_ext.portal_side_contact_us"/>
                    <!-- Hero Section -->
                    <section class="service-hero">
                        <div
                                class="service-hero-bg"
                                style="
                                  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
                                    url('/website_ext/static/src/images/our-team/our-team-bg.jpg') center / cover;
                                "
                        />
                        <div class="container">
                            <div class="row align-items-center min-vh-100">
                                <div class="col-lg-20">
                                    <div class="service-hero-content">
                                        <h1 class="service-hero-title">Meet Our Experts</h1>
                                        <p class="service-hero-subtitle">
                                            At InterCraft, we fuse innovation, expertise, and technology to
                                            build scalable solutions that
                                            <br/>
                                            empower businesses, streamline
                                            systems, and drive digital growth across industries.
                                        </p>
                                        <a href="#team-section" class="service-cta-btn">See Our People</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="service-features" id="team-section">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="section-title-sub">Our Team</h2>
                                <p class="section-subtitle">
                                    A passionate group of experts driving innovation, collaboration, and
                                    results.
                                </p>
                            </div>
                            <div class="row" style="justify-content: center;">
                                <t t-call="website_ext.team_member_card">
                                    <t t-set="team_members"
                                       t-value="request.env['website.team.member'].sudo().search(['|', ('tag_ids', '=', False), '&amp;', ('active', '=', True), ('tag_ids.name', '!=', 'ai')], order='sequence, name')"/>
                                </t>
                            </div>
                            <div class="text-center mb-5">
                                <h2 class="section-title-sub">Our AI Experts</h2>
                                <p class="section-subtitle">
                                    Experts driving innovation through intelligent systems.
                                </p>
                            </div>
                             <div class="row" style="justify-content: center;">
                                <t t-call="website_ext.team_member_card">
                                    <t t-set="team_members"
                                       t-value="request.env['website.team.member'].sudo().search([('active', '=', True), ('tag_ids.name', '=', 'ai')], order='sequence, name')"/>
                                </t>
                            </div>
                        </div>
                    </section>

                    <!-- Join Our Team Section -->
                    <section class="innovate">
                        <div class="container">
                            <div class="innovate-content text-center">
                                <h2 class="innovate-title">Join Our Team</h2>
                                <p class="innovate-subtitle">
                                    Join our team of passionate innovators and help shape the digital
                                    future.
                                </p>
                                <a href="/career" class="get-started-btn">Apply Now</a>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_our_team" model="website.menu">
        <field name="name">our-team</field>
        <field name="url">/our-team</field>
        <field name="page_id" ref="website_ext.our-team"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>