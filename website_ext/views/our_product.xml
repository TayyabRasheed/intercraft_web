                        <section class="icp-products-section">
                            <div class="container">
                                <h2 class="icp-section-main-title text-center mb-5">Our Products</h2>
                                <!-- t-nocache: product text must refresh when backend records change -->
                                <t t-nocache="Our Products cards">
                                    <t t-set="products"
                                       t-value="request.env['website.product'].sudo().search([('active', '=', True)], order='sequence, id')"/>
                                    <div class="row g-4 align-items-stretch justify-content-center icp-products-grid" t-if="products">
                                        <t t-foreach="products" t-as="product">
                                            <div class="col-12 col-md-6 col-lg-4 icp-product-col d-flex">
                                                <div class="icp-product-card w-100">
                                                    <div class="icp-product-media">
                                                        <div class="icp-product-card-header">
                                                            <t t-if="product.logo">
                                                                <img t-att-src="'/web/image/website.product/%s/logo' % product.id"
                                                                     class="icp-product-logo" alt=""/>
                                                            </t>
                                                            <t t-if="product.badge">
                                                                <span t-attf-class="icp-product-badge icp-badge-#{product.badge_style or 'website'}">
                                                                    <t t-esc="product.badge"/>
                                                                </span>
                                                            </t>
                                                        </div>
                                                        <div class="icp-product-img-container">
                                                            <t t-if="product.image">
                                                                <img t-att-src="'/web/image/website.product/%s/image' % product.id"
                                                                     class="icp-product-img" alt=""/>
                                                            </t>
                                                            <t t-else="">
                                                                <img src="/web/image/website.s_picture_default_image"
                                                                     class="icp-product-img" alt=""/>
                                                            </t>
                                                        </div>
                                                    </div>
                                                    <div class="icp-product-content">
                                                        <h4 class="icp-product-title">
                                                            <t t-esc="product.title or product.name"/>
                                                        </h4>
                                                        <div class="icp-product-tags" t-if="product.tag_ids">
                                                            <t t-foreach="product.tag_ids" t-as="tag">
                                                                <span>
                                                                    <t t-esc="tag.name"/>
                                                                </span>
                                                            </t>
                                                        </div>
                                                        <p class="icp-product-desc" t-if="product.description">
                                                            <t t-esc="product.description"/>
                                                        </p>
                                                        <a t-att-href="product.get_learn_more_url()" class="icp-product-link">Learn
                                                            More
                                                            <i class="fa fa-arrow-right ms-1"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </section>

