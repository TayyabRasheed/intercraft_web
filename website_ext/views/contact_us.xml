<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="contact-us" model="website.page">
        <field name="name">Contact Us</field>
        <field name="type">qweb</field>
        <field name="url">/contact-us</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.contact-us</field>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="website_ext.contact-us">
                <t t-call="website.layout">
                    <section class="contact-hero">
                        <div class="container">
                            <div class="row align-items-start">
                                <div class="col-lg-6">
                                    <h1 class="contact-title">Let's Build Something Great Together</h1>
                                    <p class="contact-description">
                                        Have a project in mind? Let’s turn your ideas into impact.
                                        Share your requirements, and our experts will get back to you
                                        with tailored insights and solutions.
                                    </p>
                                    <p class="contact-description">
                                        <strong>Your next step starts here. Let’s talk.</strong>
                                    </p>

                                    <div class="contact-quick-links-wrap">
                                        <div class="contact-quick-links-heading">QUICK LINKS</div>
                                        <div class="contact-quick-links">
                                            <a class="contact-quick-link contact-quick-link--primary" href="https://bookings.cloud.microsoft/book/Intercraft1@intercraftsol.com/s/BrDCGTeRLke63YVNolX0KA2?ismsaljsauthenabled" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                </span>
                                                <span class="contact-quick-link-label">Schedule Meeting</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://drive.google.com/file/d/1H8kX30nc_y-14KtHPGyTr3FP9ybDiBmh/view" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                                                </span>
                                                <span class="contact-quick-link-label">Portfolio</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://api.whatsapp.com/send/?phone=15123555400&amp;text&amp;type=phone_number&amp;app_absent=0" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <i class="fa fa-whatsapp"></i>
                                                </span>
                                                <span class="contact-quick-link-label">WhatsApp</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://www.facebook.com/Intercraftsol" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <i class="fa fa-facebook"></i>
                                                </span>
                                                <span class="contact-quick-link-label">Facebook</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://www.youtube.com/@intercraft-sol" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <i class="fa fa-youtube-play"></i>
                                                </span>
                                                <span class="contact-quick-link-label">YouTube</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://www.linkedin.com/company/intercraftsol" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <i class="fa fa-linkedin"></i>
                                                </span>
                                                <span class="contact-quick-link-label">LinkedIn</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                            <a class="contact-quick-link" href="https://www.instagram.com/intercraftsol" target="_blank" rel="noopener noreferrer">
                                                <span class="contact-quick-link-icon">
                                                    <i class="fa fa-instagram"></i>
                                                </span>
                                                <span class="contact-quick-link-label">Instagram</span>
                                                <span class="contact-quick-link-arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                                </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="contact-form">
                                        <t t-call="website.s_website_form"/>
                                    </div>
                                </div>
                                <section class="mt-4 d-block d-md-none">
                                    <div id="map-mobile"></div>
                                </section>
                            </div>
                            <section class="mt-4 d-none d-md-block">
                                <div id="map-desktop"></div>
                            </section>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>

    <record id="menu_contact_us" model="website.menu">
        <field name="name">contact-us</field>
        <field name="url">/contact-us</field>
        <field name="page_id" ref="website_ext.contact-us"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
    <template id="website_form_custom_submit_style" inherit_id="website.s_website_form">
        <xpath expr="//div[contains(@class, 's_website_form_submit')]/a" position="attributes">
            <attribute name="class" add="custom-submit-btn" separator=" "/>
            <attribute name="style">width: 100% !important;</attribute>
        </xpath>

        <xpath expr="//span[@id='s_website_form_result']" position="before">
            <br class="mt-2"/>
        </xpath>
    </template>
</odoo>
