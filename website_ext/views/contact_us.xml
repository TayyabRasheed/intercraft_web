<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contact-us" model="website.page">
        <field name="name">Contact Us</field>
        <field name="type">qweb</field>
        <field name="url">/contact-us</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">website_ext.contact-us</field>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="website_ext.contact-us">
                <t t-call="website.layout">
                    <section class="contact-hero">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <h1 class="contact-title">Let's Build Something Great Together</h1>
                                    <p class="contact-description">
                                        Have a project in mind? Need expert guidance or a custom solution?
                                        We're here to help turn your ideas into impact. Whether you're
                                        exploring a new opportunity, looking for reliable IT support, or
                                        ready to scale with smarter tech—our team is ready to jump in.
                                    </p>
                                    <p class="contact-description">
                                        Fill out the form and let's start a conversation. We'll get back
                                        to you promptly with insights, answers, or a plan tailored to your
                                        goals.
                                    </p>
                                    <p class="contact-description">
                                        <strong>Your next step starts here. Let's talk.</strong>
                                    </p>

                                    <div class="contact-info-items">
                                        <div class="contact-item">
                                            <div class="contact-icon">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="20"
                                                        height="20"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                >
                                                    <path
                                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                                    />
                                                </svg>
                                            </div>
                                            <div class="contact-details">
                                                <h5>+92 336 9237827</h5>
                                            </div>
                                        </div>
                                        <div class="contact-item">
                                            <div class="contact-icon">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="20"
                                                        height="20"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                >
                                                    <path
                                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                                    />
                                                </svg>
                                            </div>
                                            <div class="contact-details">
                                                <h5>(051) - 5913054</h5>
                                            </div>
                                        </div>

                                        <div class="contact-item">
                                            <div class="contact-icon">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="20"
                                                        height="20"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                >
                                                    <path
                                                            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                                    />
                                                    <polyline points="22,6 12,13 2,6"/>
                                                </svg>
                                            </div>
                                            <div class="contact-details">
                                                <h5>info@intercraftsol.com</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="contact-form">
                                        <form action="/website/crm/" method="POST" enctype="multipart/form-data"
                                              class="o_website_form">
                                            <input type="hidden" name="model_name" value="crm.lead"/>
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="form-group">
                                                <label class="form-label">Name</label>
                                                <input
                                                        type="text"
                                                        class="form-control"
                                                        name="name"
                                                        required="required"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Email</label>
                                                <input
                                                        type="email"
                                                        class="form-control"
                                                        name="email"
                                                        required="required"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Contact Number</label>
                                                <div class="phone-input-group">

                                                    <input
                                                            type="tel"
                                                            class="form-control phone-number"
                                                            name="phone"
                                                            required="required"
                                                    />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Subject</label>
                                                <input
                                                        type="text"
                                                        class="form-control"
                                                        name="subject"
                                                        required="required"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Message/Query</label>
                                                <textarea
                                                        class="form-control"
                                                        name="message"
                                                        rows="5"
                                                        placeholder="Tell us about your project or inquiry..."
                                                        required="required"
                                                />
                                            </div>

                                            <div class="form-group">
                                                <small class="privacy-text">
                                                    For information on our privacy practices, please review our
                                                    <a href="/">Privacy Policy</a>.
                                                </small>
                                            </div>

                                            <button type="submit" class="submit-btn">Submit</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_contact_us" model="website.menu">
        <field name="name">contact-us</field>
        <field name="url">/contact-us</field>
        <field name="page_id" ref="website_ext.contact-us"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>