<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_upcoming_event_tree_view" model="ir.ui.view">
        <field name="name">website.upcoming.event.tree</field>
        <field name="model">website.upcoming.event</field>
        <field name="arch" type="xml">
            <tree string="Upcoming Events" decoration-muted="active == False">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="website_upcoming_event_form_view" model="ir.ui.view">
        <field name="name">website.upcoming.event.form</field>
        <field name="model">website.upcoming.event</field>
        <field name="arch" type="xml">
            <form string="Upcoming Event">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. LEAP 2026"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="image" widget="image" options="{'size': [0, 0]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_upcoming_event_search_view" model="ir.ui.view">
        <field name="name">website.upcoming.event.search</field>
        <field name="model">website.upcoming.event</field>
        <field name="arch" type="xml">
            <search string="Upcoming Events">
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="website_upcoming_event_action" model="ir.actions.act_window">
        <field name="name">Upcoming Events</field>
        <field name="res_model">website.upcoming.event</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an upcoming event popup for the website.
            </p>
            <p>
                Upload a banner, turn Active on, and it will appear when visitors open the homepage.
            </p>
        </field>
    </record>

    <menuitem id="menu_website_upcoming_event"
              name="Upcoming Events"
              parent="team_member_root_menu"
              action="website_upcoming_event_action"
              sequence="50"/>

    <template id="upcoming_event_popup" inherit_id="website.layout" name="Upcoming Event Popup">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <t t-nocache="Upcoming event popup">
                <t t-set="upcoming_event" t-value="request.env['website.upcoming.event'].get_active_popup()"/>
                <t t-if="upcoming_event">
                    <div class="ic-event-popup css_editable_mode_hidden"
                         role="dialog"
                         aria-modal="true"
                         t-att-aria-label="upcoming_event.name">
                        <div class="ic-event-popup-backdrop"
                             data-ic-event-close="1"
                             onclick="var p=this.closest('.ic-event-popup'); if(p){p.classList.add('is-hidden'); p.style.display='none'; document.body.classList.remove('ic-event-popup-open');}"></div>
                        <div class="ic-event-popup-dialog">
                            <a href="/contact-us" class="ic-event-popup-media">
                                <img t-attf-src="/web/image/website.upcoming.event/#{upcoming_event.id}/image"
                                     t-att-alt="upcoming_event.name"
                                     loading="eager"
                                     data-no-post-process="1"/>
                            </a>
                            <button type="button"
                                    class="ic-event-popup-close"
                                    aria-label="Close"
                                    data-ic-event-close="1"
                                    onclick="var p=this.closest('.ic-event-popup'); if(p){p.classList.add('is-hidden'); p.style.display='none'; document.body.classList.remove('ic-event-popup-open');}">
                                <span aria-hidden="true">&#215;</span>
                            </button>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
